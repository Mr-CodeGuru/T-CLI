{
	"extends": "@sindresorhus/tsconfig",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "source",
		"moduleResolution": "node16",
		"module": "Node16",
		"target": "ESNext",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false
	},
	"include": ["source/**/*"]
}
