# T-CLI API Keys — ~/.mycli/.env
# Copy this file to ~/.mycli/.env and fill in your keys.
# T-CLI loads this file automatically on startup.

# Google Gemini (default provider)
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=alternative_name_also_works

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq (free tier available)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (access to many models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Python binary override (default: python3)
# TCLI_PYTHON=/usr/local/bin/python3.11
