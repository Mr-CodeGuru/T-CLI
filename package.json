{
	"name": "t-cli",
	"version": "1.0.0",
	"description": "A local AI CLI tool with streaming, themes, sessions, and multi-provider support",
	"license": "MIT",
	"bin": "dist/cli.js",
	"type": "module",
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsx source/cli.tsx",
		"start": "node dist/cli.js",
		"reset": "rm -f ~/.mycli/.env && npm run build && node dist/cli.js",
		"test": "vitest run"
	},
	"files": [
		"dist",
		"backend"
	],
	"dependencies": {
		"ansi-escapes": "^6.2.0",
		"better-sqlite3": "^9.4.3",
		"boxen": "^7.1.1",
		"chalk": "^5.3.0",
		"cli-table3": "^0.6.3",
		"dotenv": "^16.4.5",
		"ink": "^4.1.0",
		"ink-text-input": "^5.0.1",
		"marked": "^12.0.0",
		"marked-terminal": "^7.0.0",
		"meow": "^11.0.0",
		"ora": "^8.0.1",
		"react": "^18.2.0",
		"slice-ansi": "^7.1.0",
		"string-width": "^7.1.0",
		"uuid": "^9.0.1",
		"wrap-ansi": "^9.0.0"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^3.0.1",
		"@types/better-sqlite3": "^7.6.8",
		"@types/react": "^18.0.32",
		"@types/uuid": "^9.0.7",
		"@vdemedes/prettier-config": "^2.0.1",
		"esbuild": "^0.20.2",
		"prettier": "^2.8.7",
		"tsx": "^4.7.2",
		"typescript": "^5.0.3",
		"vitest": "^1.4.0"
	},
	"prettier": "@vdemedes/prettier-config"
}
